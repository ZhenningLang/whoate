{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whoate.local/schema/whoate-v1.schema.json",
  "title": "whoate/v1 additive output contract",
  "description": "Memory is bytes; CPU is percent of one core and may exceed 100. Unknown is null, not zero. Swarm distributions may reference owner IDs outside a filtered view; use whoate why <id> to inspect them. Future additive keys are allowed. WHOATE_SESSION_PID is an optional narrowing validation capability: before source opens, allow only one positive Claude PID, stop at its first user/assistant record pair without tail/read-ahead, and take title only from session metadata (otherwise null). It grants no authorization and does not filter resource sampling; unset preserves normal source behavior.",
  "type": "object",
  "required": ["schema"],
  "properties": {"schema": {"const": "whoate/v1"}},
  "oneOf": [
    {"$ref": "#/$defs/report"},
    {"$ref": "#/$defs/kill"},
    {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "integer", "enum": [1,2,3,4]}, "message": {"type": "string"}}}}}
  ],
  "$defs": {
    "uint": {"type": "integer", "minimum": 0},
    "nullableUint": {"type": ["integer", "null"], "minimum": 0},
    "cpu": {"type": ["number", "null"], "minimum": 0},
    "nullableString": {"type": ["string", "null"]},
    "strings": {"type": "array", "items": {"type": "string"}},
    "pids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "confidence": {"enum": ["certain", "inferred", "weak"]},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["kind", "detail", "confidence"], "properties": {"kind": {"type": "string"}, "detail": {"type": "string"}, "confidence": {"$ref": "#/$defs/confidence"}}}},
    "verdict": {"type": "object", "required": ["level", "rule", "text"], "properties": {"level": {"enum": ["ok", "watch", "act"]}, "rule": {"type": "string"}, "text": {"type": "string"}, "action": {"type": "string"}}},
    "host": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["mem_total_bytes", "mem_used_bytes", "compressed_bytes", "wired_bytes", "swap_used_bytes", "pressure"], "properties": {"mem_total_bytes": {"$ref": "#/$defs/uint"}, "mem_used_bytes": {"$ref": "#/$defs/uint"}, "compressed_bytes": {"$ref": "#/$defs/uint"}, "wired_bytes": {"$ref": "#/$defs/uint"}, "swap_used_bytes": {"$ref": "#/$defs/uint"}, "pressure": {"enum": ["normal", "warn", "critical"]}, "kernel_zones": {"$ref":"#/$defs/kernel_zones"}, "gpu_memory":{"$ref":"#/$defs/gpu_memory"}, "memory_diagnostics":{"type":"array","items":{"$ref":"#/$defs/verdict"}}, "cpu":{"description":"Whole machine since the previous sample: usage_pct is 0-100 of all cores (not one core). missing carries a reason and null usage, never 0.","type":"object","required":["status","usage_pct","load_1m","logical_cores","reason"],"properties":{"status":{"enum":["fresh","missing"]},"usage_pct":{"type":["number","null"],"minimum":0,"maximum":100},"load_1m":{"type":["number","null"],"minimum":0},"logical_cores":{"$ref":"#/$defs/nullableUint"},"reason":{"$ref":"#/$defs/nullableString"}}}}}]},
    "origin": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["tmux_pane", "pane_alive", "cwd", "ports"], "properties": {"tmux_pane": {"$ref": "#/$defs/nullableString"}, "pane_alive": {"type": ["boolean", "null"]}, "cwd": {"$ref": "#/$defs/nullableString"}, "pane_title":{"$ref":"#/$defs/nullableString"}, "window_name":{"$ref":"#/$defs/nullableString"}, "tmux_target": {"type": "string", "description": "R10: the live pane's session:window.pane; absent without a live pane"}, "ports": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 0, "maximum": 65535}}}}]},
    "agent": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["tool", "session_id", "name", "name_source", "title", "first_prompt", "first_reply", "status", "cwd", "branch", "model", "cost_usd", "confidence", "updated_at_ms", "stale"], "properties": {"tool": {"type": "string"}, "session_id": {"$ref": "#/$defs/nullableString"}, "name": {"$ref": "#/$defs/nullableString"}, "name_source": {"$ref": "#/$defs/nullableString"}, "title": {"$ref": "#/$defs/nullableString"}, "first_prompt": {"$ref": "#/$defs/nullableString"}, "first_reply": {"$ref": "#/$defs/nullableString"}, "status": {"$ref": "#/$defs/nullableString"}, "cwd": {"$ref": "#/$defs/nullableString"}, "branch": {"$ref": "#/$defs/nullableString"}, "model": {"$ref": "#/$defs/nullableString"}, "cost_usd": {"type": ["number", "null"], "minimum": 0}, "confidence": {"$ref": "#/$defs/confidence"}, "updated_at_ms": {"type": ["integer", "null"]}, "last_activity_at":{"type":["string","null"],"format":"date-time"}, "idle_seconds":{"$ref":"#/$defs/nullableUint"}, "stale": {"type": "boolean"}}}]},
    "part": {"type": "object", "required": ["name", "mem_bytes", "process_count", "pids", "unknown_mem_count"], "properties": {"name": {"type": "string"}, "mem_bytes": {"$ref": "#/$defs/uint"}, "process_count": {"$ref": "#/$defs/uint"}, "pids": {"$ref": "#/$defs/pids"}, "unknown_mem_count": {"$ref": "#/$defs/uint"}}},
    "fact": {"type": "object", "required": ["key", "label", "value"], "properties": {"key": {"type": "string"}, "label": {"type": "string"}, "value": {"anyOf": [{"type": ["string", "number", "boolean"]}, {"$ref": "#/$defs/strings"}]}}},
    "history": {"type": "array", "items": {"type": "object", "required": ["timestamp_s", "mem_bytes", "cpu_pct"], "properties": {"timestamp_s": {"type": "integer"}, "mem_bytes": {"$ref": "#/$defs/uint"}, "cpu_pct": {"$ref": "#/$defs/cpu"}, "unknown_mem_count": {"$ref": "#/$defs/uint"}, "cpu_pct_readable": {"type": "number", "minimum": 0, "description": "R12: sum over the processes whose CPU was read when cpu_pct is null; absent when every process was read"}, "unknown_cpu_count": {"type": "integer", "minimum": 1, "description": "R12: processes whose CPU could not be read; absent when none"}}}},
    "owner": {"type": "object", "required": ["id", "kind", "label", "mem_bytes", "unknown_mem_count", "cpu_pct", "pids", "origin", "agent", "evidence", "parts", "facts", "insights", "verdict"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["tmux_pane", "agent_session", "app", "orphan", "service", "system"]}, "label": {"type": "string"}, "mem_bytes": {"$ref": "#/$defs/uint"}, "reclaimable_physical":{"$ref":"#/$defs/physical_estimate"}, "unknown_mem_count": {"$ref": "#/$defs/uint"}, "cpu_pct": {"$ref": "#/$defs/cpu"}, "cpu_pct_readable": {"type": "number", "minimum": 0, "description": "R12: sum over the processes whose CPU was read when cpu_pct is null; absent when every process was read"}, "unknown_cpu_count": {"type": "integer", "minimum": 1, "description": "R12: processes whose CPU could not be read; absent when none"}, "pids": {"$ref": "#/$defs/pids"}, "origin": {"$ref": "#/$defs/origin"}, "agent": {"$ref": "#/$defs/agent"}, "evidence": {"$ref": "#/$defs/evidence"}, "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}}, "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}, "insights": {"$ref": "#/$defs/strings"}, "history": {"$ref": "#/$defs/history"}, "verdict": {"$ref": "#/$defs/verdict"}}},
    "physical_estimate":{"type":"object","required":["bytes","unknown_count","basis","reason"],"properties":{"bytes":{"$ref":"#/$defs/nullableUint"},"unknown_count":{"$ref":"#/$defs/uint"},"basis":{"type":"string"},"reason":{"$ref":"#/$defs/nullableString"}}},
    "kernel_zones":{"type":"object","required":["status","as_of","basis","top","reason"],"properties":{"status":{"enum":["fresh","stale","missing"]},"as_of":{"type":["string","null"],"format":"date-time"},"basis":{"type":"string"},"reason":{"$ref":"#/$defs/nullableString"},"top":{"type":"array","maxItems":5,"items":{"type":"object","required":["name","bytes","collectible","pageable"],"properties":{"name":{"type":"string"},"bytes":{"$ref":"#/$defs/uint"},"collectible":{"type":["boolean","null"]},"pageable":{"type":["boolean","null"]}}}}}},
    "gpu_memory":{"type":"object","required":["status","as_of","bytes","source","reason"],"properties":{"status":{"enum":["fresh","stale","missing"]},"as_of":{"type":["string","null"],"format":"date-time"},"bytes":{"$ref":"#/$defs/nullableUint"},"source":{"$ref":"#/$defs/nullableString"},"reason":{"$ref":"#/$defs/nullableString"}}},
    "memory_measurement":{"type":"object","required":["measured_at","host_used_bytes","target_resident_bytes","unknown_count","reason"],"properties":{"measured_at":{"type":["string","null"],"format":"date-time"},"host_used_bytes":{"$ref":"#/$defs/nullableUint"},"target_resident_bytes":{"$ref":"#/$defs/nullableUint"},"unknown_count":{"$ref":"#/$defs/uint"},"reason":{"$ref":"#/$defs/nullableString"}}},
    "kill":{"type":"object","required":["executed","results","missing_targets","memory"],"properties":{"executed":{"type":"boolean"},"results":{"type":"array","items":{"type":"object","required":["pid","status","reason"],"properties":{"pid":{"type":"integer"},"status":{"enum":["terminated","still_alive","refused","missing"]},"reason":{"$ref":"#/$defs/nullableString"}}}},"missing_targets":{"$ref":"#/$defs/strings"},"memory":{"type":"object","required":["before","after","physical_memory_change_bytes","target_resident_change_bytes","basis"],"properties":{"before":{"$ref":"#/$defs/memory_measurement"},"after":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/memory_measurement"}]},"physical_memory_change_bytes":{"type":["integer","null"]},"target_resident_change_bytes":{"type":["integer","null"]},"basis":{"type":"string"}}}}},
    "swarm": {"type": "object", "required": ["signature", "label", "count", "mem_bytes", "unknown_mem_count", "cpu_pct", "shape", "owners", "parents", "started_span_s", "pids", "evidence", "verdict"], "properties": {"signature": {"type": "string"}, "label": {"type": "string"}, "count": {"$ref": "#/$defs/uint"}, "mem_bytes": {"$ref": "#/$defs/uint"}, "unknown_mem_count": {"$ref": "#/$defs/uint"}, "cpu_pct": {"$ref": "#/$defs/cpu"}, "cpu_pct_readable": {"type": "number", "minimum": 0, "description": "R12: sum over the processes whose CPU was read when cpu_pct is null; absent when every process was read"}, "unknown_cpu_count": {"type": "integer", "minimum": 1, "description": "R12: processes whose CPU could not be read; absent when none"}, "shape": {"enum": ["burst", "spread"]}, "owners": {"type": "array", "description": "Full distribution; IDs may be outside this filtered Report.owners", "items": {"type": "object", "required": ["id", "count"], "properties": {"id": {"type": "string"}, "count": {"$ref": "#/$defs/uint"}}}}, "parents": {"$ref": "#/$defs/pids"}, "started_span_s": {"$ref": "#/$defs/cpu"}, "pids": {"$ref": "#/$defs/pids"}, "evidence": {"$ref": "#/$defs/evidence"}, "verdict": {"$ref": "#/$defs/verdict"}}},
    "report": {"type": "object", "required": ["taken_at", "host", "system_procs", "owners", "swarms", "issues"], "properties": {"taken_at": {"type": "string", "format": "date-time"}, "host": {"$ref": "#/$defs/host"}, "system_procs": {"type": "object", "required": ["status", "as_of"], "properties": {"status": {"enum": ["fresh", "stale", "missing"]}, "as_of": {"type": ["string", "null"], "format": "date-time"}}}, "owners": {"type": "array", "items": {"$ref": "#/$defs/owner"}}, "swarms": {"type": "array", "items": {"$ref": "#/$defs/swarm"}}, "issues": {"type": "array", "items": {"type": "object", "required": ["stage", "pid", "code"], "properties": {"stage": {"type": "string"}, "pid": {"type": ["integer", "null"]}, "code": {"type": "string"}}}}, "procs": {"type": "array", "description": "whoate_why only: the owners' processes (in_owner, argv redacted by the fixture rules) and their ancestors up to launchd (pid, ppid, comm only)", "items": {"$ref": "#/$defs/proc_brief"}}}},
    "proc_brief": {"type": "object", "required": ["pid", "ppid", "comm", "in_owner"], "properties": {"pid": {"type": "integer"}, "ppid": {"type": "integer"}, "comm": {"type": "string"}, "in_owner": {"type": "boolean"}, "mem_bytes": {"$ref": "#/$defs/nullableUint"}, "cwd": {"$ref": "#/$defs/nullableString"}, "argv": {"$ref": "#/$defs/strings"}, "name": {"type": "string", "description": "R10: readable program name; comm is the kernel's short name (a version for Claude Code, 15 bytes for others)"}}}
  }
}
