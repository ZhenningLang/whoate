{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whoate.local/schema/whoate-v1.schema.json",
  "title": "whoate/v1 additive output contract",
  "description": "Memory is bytes; CPU is percent of one core and may exceed 100. Unknown is null, not zero. Swarm distributions may reference owner IDs outside a filtered view; use whoate why <id> to inspect them. Future additive keys are allowed. WHOATE_SESSION_PID is an optional narrowing validation capability: before source opens, allow only one positive Claude PID, stop at its first user/assistant record pair without tail/read-ahead, and take title only from session metadata (otherwise null). It grants no authorization and does not filter resource sampling; unset preserves normal source behavior.",
  "type": "object",
  "required": ["schema"],
  "properties": {"schema": {"const": "whoate/v1"}},
  "oneOf": [
    {"$ref": "#/$defs/report"},
    {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "integer", "enum": [1,2,3,4]}, "message": {"type": "string"}}}}}
  ],
  "$defs": {
    "uint": {"type": "integer", "minimum": 0},
    "nullableUint": {"type": ["integer", "null"], "minimum": 0},
    "cpu": {"type": ["number", "null"], "minimum": 0},
    "nullableString": {"type": ["string", "null"]},
    "strings": {"type": "array", "items": {"type": "string"}},
    "pids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "confidence": {"enum": ["certain", "inferred", "weak"]},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["kind", "detail", "confidence"], "properties": {"kind": {"type": "string"}, "detail": {"type": "string"}, "confidence": {"$ref": "#/$defs/confidence"}}}},
    "verdict": {"type": "object", "required": ["level", "rule", "text"], "properties": {"level": {"enum": ["ok", "watch", "act"]}, "rule": {"type": "string"}, "text": {"type": "string"}, "action": {"type": "string"}}},
    "host": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["mem_total_bytes", "mem_used_bytes", "compressed_bytes", "wired_bytes", "swap_used_bytes", "pressure"], "properties": {"mem_total_bytes": {"$ref": "#/$defs/uint"}, "mem_used_bytes": {"$ref": "#/$defs/uint"}, "compressed_bytes": {"$ref": "#/$defs/uint"}, "wired_bytes": {"$ref": "#/$defs/uint"}, "swap_used_bytes": {"$ref": "#/$defs/uint"}, "pressure": {"enum": ["normal", "warn", "critical"]}}}]},
    "origin": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["tmux_pane", "pane_alive", "cwd", "ports"], "properties": {"tmux_pane": {"$ref": "#/$defs/nullableString"}, "pane_alive": {"type": ["boolean", "null"]}, "cwd": {"$ref": "#/$defs/nullableString"}, "ports": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 0, "maximum": 65535}}}}]},
    "agent": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["tool", "session_id", "name", "name_source", "title", "first_prompt", "first_reply", "status", "cwd", "branch", "model", "cost_usd", "confidence", "updated_at_ms", "stale"], "properties": {"tool": {"type": "string"}, "session_id": {"$ref": "#/$defs/nullableString"}, "name": {"$ref": "#/$defs/nullableString"}, "name_source": {"$ref": "#/$defs/nullableString"}, "title": {"$ref": "#/$defs/nullableString"}, "first_prompt": {"$ref": "#/$defs/nullableString"}, "first_reply": {"$ref": "#/$defs/nullableString"}, "status": {"$ref": "#/$defs/nullableString"}, "cwd": {"$ref": "#/$defs/nullableString"}, "branch": {"$ref": "#/$defs/nullableString"}, "model": {"$ref": "#/$defs/nullableString"}, "cost_usd": {"type": ["number", "null"], "minimum": 0}, "confidence": {"$ref": "#/$defs/confidence"}, "updated_at_ms": {"type": ["integer", "null"]}, "stale": {"type": "boolean"}}}]},
    "part": {"type": "object", "required": ["name", "mem_bytes", "process_count", "pids", "unknown_mem_count"], "properties": {"name": {"type": "string"}, "mem_bytes": {"$ref": "#/$defs/uint"}, "process_count": {"$ref": "#/$defs/uint"}, "pids": {"$ref": "#/$defs/pids"}, "unknown_mem_count": {"$ref": "#/$defs/uint"}}},
    "fact": {"type": "object", "required": ["key", "label", "value"], "properties": {"key": {"type": "string"}, "label": {"type": "string"}, "value": {"anyOf": [{"type": ["string", "number", "boolean"]}, {"$ref": "#/$defs/strings"}]}}},
    "history": {"type": "array", "items": {"type": "object", "required": ["timestamp_s", "mem_bytes", "cpu_pct"], "properties": {"timestamp_s": {"type": "integer"}, "mem_bytes": {"$ref": "#/$defs/uint"}, "cpu_pct": {"$ref": "#/$defs/cpu"}}}},
    "owner": {"type": "object", "required": ["id", "kind", "label", "mem_bytes", "unknown_mem_count", "cpu_pct", "pids", "origin", "agent", "evidence", "parts", "facts", "insights", "verdict"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["tmux_pane", "agent_session", "app", "orphan", "service", "system"]}, "label": {"type": "string"}, "mem_bytes": {"$ref": "#/$defs/uint"}, "unknown_mem_count": {"$ref": "#/$defs/uint"}, "cpu_pct": {"$ref": "#/$defs/cpu"}, "pids": {"$ref": "#/$defs/pids"}, "origin": {"$ref": "#/$defs/origin"}, "agent": {"$ref": "#/$defs/agent"}, "evidence": {"$ref": "#/$defs/evidence"}, "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}}, "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}, "insights": {"$ref": "#/$defs/strings"}, "history": {"$ref": "#/$defs/history"}, "verdict": {"$ref": "#/$defs/verdict"}}},
    "swarm": {"type": "object", "required": ["signature", "label", "count", "mem_bytes", "unknown_mem_count", "cpu_pct", "shape", "owners", "parents", "started_span_s", "pids", "evidence", "verdict"], "properties": {"signature": {"type": "string"}, "label": {"type": "string"}, "count": {"$ref": "#/$defs/uint"}, "mem_bytes": {"$ref": "#/$defs/uint"}, "unknown_mem_count": {"$ref": "#/$defs/uint"}, "cpu_pct": {"$ref": "#/$defs/cpu"}, "shape": {"enum": ["burst", "spread"]}, "owners": {"type": "array", "description": "Full distribution; IDs may be outside this filtered Report.owners", "items": {"type": "object", "required": ["id", "count"], "properties": {"id": {"type": "string"}, "count": {"$ref": "#/$defs/uint"}}}}, "parents": {"$ref": "#/$defs/pids"}, "started_span_s": {"$ref": "#/$defs/cpu"}, "pids": {"$ref": "#/$defs/pids"}, "evidence": {"$ref": "#/$defs/evidence"}, "verdict": {"$ref": "#/$defs/verdict"}}},
    "report": {"type": "object", "required": ["taken_at", "host", "system_procs", "owners", "swarms", "issues"], "properties": {"taken_at": {"type": "string", "format": "date-time"}, "host": {"$ref": "#/$defs/host"}, "system_procs": {"type": "object", "required": ["status", "as_of"], "properties": {"status": {"enum": ["fresh", "stale", "missing"]}, "as_of": {"type": ["string", "null"], "format": "date-time"}}}, "owners": {"type": "array", "items": {"$ref": "#/$defs/owner"}}, "swarms": {"type": "array", "items": {"$ref": "#/$defs/swarm"}}, "issues": {"type": "array", "items": {"type": "object", "required": ["stage", "pid", "code"], "properties": {"stage": {"type": "string"}, "pid": {"type": ["integer", "null"]}, "code": {"type": "string"}}}}}}
  }
}
